# Copy to .env.local for local dev. On Vercel, set these under Project Settings > Environment Variables.
# Never commit real values. .env* is gitignored except this example file.

# Neon Postgres connection string (Neon dashboard > Connection Details, use the pooled "postgresql://" URL).
DATABASE_URL=

# Random secret used to sign session cookies. Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Discord OAuth app (https://discord.com/developers/applications > OAuth2).
# Redirect URL to register there: <your-site>/api/auth/callback/discord
# For local dev also add: http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# ---------------------------------------------------------------------------------------------
# AI analysis (M5). Nothing here is required for the rest of the app; /analysis stays disabled until
# these are set. Prices and model names change, so copy them from your provider's own pages.
# ---------------------------------------------------------------------------------------------
# "openai-compatible" for any provider that offers a chat-completions endpoint of that style (check the
# provider's docs for its exact base URL and model names), or "fake" for a keyless demo that returns
# placeholder text and costs nothing.
LLM_PROVIDER=
# https base URL up to (not including) /chat/completions, e.g. https://<provider-host>/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# USD per 1,000,000 tokens, as listed on the provider's pricing page. Both are REQUIRED: they drive the
# spending cap. If the provider bills in another currency, convert to USD.
LLM_INPUT_PRICE_PER_MTOK_USD=
LLM_OUTPUT_PRICE_PER_MTOK_USD=
# Hard cap on total spend per UTC day across all users, in USD (REQUIRED for a real provider), e.g. 5
CHAT_DAILY_CAP_USD=
# Optional (defaults in brackets)
# LLM_USER_DAILY_LIMIT=5          analyses per user per UTC day [5]
# LLM_MAX_OUTPUT_TOKENS=2000      [2000]
# LLM_MAX_INPUT_TOKENS=30000      refuse (rather than truncate) beyond this estimate [30000]
# LLM_TIMEOUT_MS=45000            TOTAL time for one analysis including retries [45000, max 55000]
# LLM_MAX_RETRIES=1               extra attempts after a quick failure (connection error, HTTP 408/429/500/502/503/504/529).
#                                 0 = never retry. Never retries a timeout. A retried call may be billed twice if the
#                                 provider billed the failed attempt (unverified) [1, max 3]
# LLM_REASONING_EFFORT=low        none | minimal | low | medium | high. Sent as reasoning_effort only when set. Whether a
#                                 model accepts it, and which values, depends on the provider and model: check its docs
# LLM_JSON_MODE=1                 send response_format json_object; only if the provider supports it
